# ── Shopify Partner Dashboard'dan alınır ──────────────────────────────
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Uygulamanın herkese açık HTTPS adresi.
# DİKKAT: Alan adında "shopify" kelimesi GEÇMEMELİ (Shopify marka politikası).
SHOPIFY_APP_URL=https://scratchcart.up.railway.app

SCOPES=read_products,read_orders,write_discounts,read_discounts

# ── Veritabanı ────────────────────────────────────────────────────────
# Railway PostgreSQL eklentisi bu değişkeni otomatik sağlar.
DATABASE_URL=postgresql://user:pass@host:5432/scratchcart

# ── Çalışma zamanı ────────────────────────────────────────────────────
NODE_ENV=production
# PORT Railway tarafından sağlanır; yerelde varsayılan 3000'dir.
